<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.petshop.controller.DashboardController"
            stylesheets="@../css/styles.css"
            prefWidth="1280" prefHeight="800">

    <!-- ===== SIDEBAR ===== -->
    <left>
        <VBox styleClass="sidebar">
            <!-- Header -->
            <VBox styleClass="sidebar-header" spacing="4">
                <Label text="🐾 Pet Shop" styleClass="sidebar-title"/>
                <Label fx:id="lblUserInfo" text="Admin" styleClass="sidebar-subtitle"/>
            </VBox>

            <!-- Menu Items -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="2" style="-fx-padding: 8 0;">
                    <!-- Main -->
                    <Label text="CHÍNH" styleClass="sidebar-section-label"/>
                    <Button fx:id="btnDashboard" text="🏠  Tổng quan"
                            styleClass="sidebar-menu-item, active"
                            onAction="#showDashboard" maxWidth="Infinity"/>
                    <Button fx:id="btnInvoice" text="🧾  Hóa đơn bán hàng"
                            styleClass="sidebar-menu-item"
                            onAction="#showInvoice" maxWidth="Infinity"/>
                    <Button fx:id="btnImportOrder" text="📦  Nhập hàng"
                            styleClass="sidebar-menu-item"
                            onAction="#showImportOrder" maxWidth="Infinity"/>

                    <!-- Catalog -->
                    <Label text="DANH MỤC" styleClass="sidebar-section-label"/>
                    <Button fx:id="btnPet" text="🐶  Thú cưng"
                            styleClass="sidebar-menu-item"
                            onAction="#showPet" maxWidth="Infinity"/>
                    <Button fx:id="btnAccessory" text="🎒  Phụ kiện"
                            styleClass="sidebar-menu-item"
                            onAction="#showAccessory" maxWidth="Infinity"/>
                    <Button fx:id="btnService" text="🛁  Dịch vụ"
                            styleClass="sidebar-menu-item"
                            onAction="#showService" maxWidth="Infinity"/>

                    <!-- Partners -->
                    <Label text="ĐỐI TÁC" styleClass="sidebar-section-label"/>
                    <Button fx:id="btnCustomer" text="👥  Khách hàng"
                            styleClass="sidebar-menu-item"
                            onAction="#showCustomer" maxWidth="Infinity"/>
                    <Button fx:id="btnSupplier" text="🏭  Nhà cung cấp"
                            styleClass="sidebar-menu-item"
                            onAction="#showSupplier" maxWidth="Infinity"/>

                    <!-- Reports -->
                    <Label text="BÁO CÁO" styleClass="sidebar-section-label"/>
                    <Button fx:id="btnReport" text="📊  Báo cáo thống kê"
                            styleClass="sidebar-menu-item"
                            onAction="#showReport" maxWidth="Infinity"/>

                    <!-- Admin only -->
                    <Label fx:id="lblAdminSection" text="QUẢN TRỊ" styleClass="sidebar-section-label"/>
                    <Button fx:id="btnUsers" text="⚙️  Quản lý Users"
                            styleClass="sidebar-menu-item"
                            onAction="#showUsers" maxWidth="Infinity"/>
                </VBox>
            </ScrollPane>

            <!-- Logout Button -->
            <Button text="🚪  Đăng xuất" styleClass="sidebar-menu-item"
                    onAction="#onLogout" maxWidth="Infinity"
                    style="-fx-border-color: #30363d transparent transparent transparent; -fx-border-width: 1 0 0 0;"/>
        </VBox>
    </left>

    <!-- ===== MAIN CONTENT ===== -->
    <center>
        <StackPane fx:id="contentArea" styleClass="content-area">
            <!-- Default: Dashboard view embedded inline -->
            <VBox fx:id="dashboardView">
                <!-- Page Header -->
                <HBox styleClass="page-header" alignment="CENTER_LEFT">
                    <Label text="Tổng quan" styleClass="page-title"/>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent; -fx-border-color: transparent;">
                    <VBox styleClass="page-body" spacing="20">
                        <!-- KPI Cards Row -->
                        <HBox spacing="16">
                            <!-- Doanh thu hôm nay -->
                            <VBox styleClass="kpi-card, kpi-card-revenue" HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="💰" styleClass="kpi-icon"/>
                                    <VBox spacing="2">
                                        <Label fx:id="kpiRevenue" text="0 đ" styleClass="kpi-value"/>
                                        <Label text="Doanh thu hôm nay" styleClass="kpi-label"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            <!-- Thú đang tồn -->
                            <VBox styleClass="kpi-card, kpi-card-pets" HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="🐾" styleClass="kpi-icon"/>
                                    <VBox spacing="2">
                                        <Label fx:id="kpiPetsAvailable" text="0" styleClass="kpi-value"/>
                                        <Label text="Thú đang tồn" styleClass="kpi-label"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            <!-- HĐ hôm nay -->
                            <VBox styleClass="kpi-card, kpi-card-invoice" HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="🧾" styleClass="kpi-icon"/>
                                    <VBox spacing="2">
                                        <Label fx:id="kpiInvoicesToday" text="0" styleClass="kpi-value"/>
                                        <Label text="Hóa đơn hôm nay" styleClass="kpi-label"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                            <!-- Cảnh báo -->
                            <VBox styleClass="kpi-card, kpi-card-warning" HBox.hgrow="ALWAYS" spacing="8">
                                <HBox alignment="CENTER_LEFT" spacing="12">
                                    <Label text="⚠️" styleClass="kpi-icon"/>
                                    <VBox spacing="2">
                                        <Label fx:id="kpiLowStock" text="0" styleClass="kpi-value"/>
                                        <Label text="Phụ kiện sắp hết" styleClass="kpi-label"/>
                                    </VBox>
                                </HBox>
                            </VBox>
                        </HBox>

                        <!-- Charts Row -->
                        <HBox spacing="16">
                            <!-- Biểu đồ doanh thu 7 ngày -->
                            <VBox HBox.hgrow="ALWAYS" styleClass="chart" spacing="8">
                                <Label text="Doanh thu 7 ngày gần nhất" styleClass="form-section-title"/>
                                <BarChart fx:id="chartRevenue" prefHeight="220">
                                    <xAxis><CategoryAxis label="Ngày"/></xAxis>
                                    <yAxis><NumberAxis label="Doanh thu (đ)"/></yAxis>
                                </BarChart>
                            </VBox>

                            <!-- Thú tồn theo loài -->
                            <VBox prefWidth="300" styleClass="chart" spacing="8">
                                <Label text="Tồn kho theo loài" styleClass="form-section-title"/>
                                <PieChart fx:id="chartPetStock" prefHeight="220"/>
                            </VBox>
                        </HBox>

                        <!-- Recent Invoices -->
                        <VBox styleClass="chart" spacing="8">
                            <Label text="Hóa đơn gần đây" styleClass="form-section-title"/>
                            <TableView fx:id="tableRecentInvoices" prefHeight="200">
                                <columns>
                                    <TableColumn fx:id="colInvCode"     text="Số HĐ"        prefWidth="130"/>
                                    <TableColumn fx:id="colInvDate"     text="Ngày"          prefWidth="130"/>
                                    <TableColumn fx:id="colInvCustomer" text="Khách hàng"    prefWidth="180"/>
                                    <TableColumn fx:id="colInvTotal"    text="Tổng tiền"     prefWidth="140"/>
                                    <TableColumn fx:id="colInvPayment"  text="PTTT"          prefWidth="110"/>
                                    <TableColumn fx:id="colInvStatus"   text="Trạng thái"    prefWidth="110"/>
                                </columns>
                            </TableView>
                        </VBox>
                    </VBox>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>

</BorderPane>
