<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.petshop.controller.ReportController"
      stylesheets="@../css/styles.css"
      spacing="0"
      style="-fx-background-color: #f8f9fa;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="16" right="24" bottom="16" left="24"/>
        </padding>
        <Label text="📊 Báo cáo Thống kê &amp; Lợi nhuận"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnExportExcel"
                text="📊 Xuất Báo Cáo Excel"
                styleClass="btn-primary"
                onAction="#onExportExcel"/>
    </HBox>

    <!-- FILTER BAR -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="12" right="24" bottom="12" left="24"/>
        </padding>

        <Label text="Từ ngày:"/>
        <DatePicker fx:id="dpFrom" prefWidth="130" style="-fx-pref-height: 36px;"/>

        <Label text="Đến ngày:"/>
        <DatePicker fx:id="dpTo" prefWidth="130" style="-fx-pref-height: 36px;"/>

        <Button text="🔍 Xem báo cáo"
                styleClass="btn-outline"
                onAction="#loadReports"
                style="-fx-pref-height: 36px;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Label fx:id="lblSummaryRevenue"
               text="Tổng doanh thu: 0 đ"
               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #0969da;"/>
    </HBox>

    <!-- TABS -->
    <TabPane VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE">
        <!-- TAB 1: DOANH THU THEO NGÀY -->
        <Tab text="💰 Doanh thu theo ngày">
            <VBox spacing="8" style="-fx-padding: 16;">
                <TableView fx:id="tableDailyRevenue" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colRevDate"  text="Ngày bán" prefWidth="150" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colRevCount" text="Số hóa đơn" prefWidth="120" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colRevTotal" text="Doanh thu (VNĐ)" prefWidth="180" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold;"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 2: LỢI NHUẬN THEO GIỐNG THÚ -->
        <Tab text="📈 Lãi / Lỗ theo giống thú">
            <VBox spacing="8" style="-fx-padding: 16;">
                <TableView fx:id="tableProfit" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colProfitBreed"  text="Giống thú cưng" prefWidth="180"/>
                        <TableColumn fx:id="colProfitCount"  text="Đã bán" prefWidth="100" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colProfitImport" text="Tổng giá nhập" prefWidth="140" style="-fx-alignment: CENTER_RIGHT;"/>
                        <TableColumn fx:id="colProfitSell"   text="Tổng giá bán"  prefWidth="140" style="-fx-alignment: CENTER_RIGHT;"/>
                        <TableColumn fx:id="colProfitNet"    text="Lợi nhuận gộp" prefWidth="160" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold; -fx-text-fill: #1a7f37;"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 3: TOP GIỐNG BÁN CHẠY -->
        <Tab text="🏆 Thú bán chạy nhất">
            <VBox spacing="8" style="-fx-padding: 16;">
                <TableView fx:id="tableTopBreeds" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTopBreed" text="Giống thú cưng" prefWidth="200"/>
                        <TableColumn fx:id="colTopCount" text="Số lượng đã bán" prefWidth="150" style="-fx-alignment: CENTER; -fx-font-weight: bold;"/>
                        <TableColumn fx:id="colTopSales" text="Tổng doanh số" prefWidth="180" style="-fx-alignment: CENTER_RIGHT;"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>

        <!-- TAB 4: PHỤ KIỆN SẮP HẾT HÀNG -->
        <Tab text="⚠️ Cảnh báo tồn kho phụ kiện">
            <VBox spacing="8" style="-fx-padding: 16;">
                <TableView fx:id="tableLowStock" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colLowName"     text="Tên phụ kiện" prefWidth="250"/>
                        <TableColumn fx:id="colLowCategory" text="Danh mục" prefWidth="140" style="-fx-alignment: CENTER;"/>
                        <TableColumn fx:id="colLowQty"      text="Tồn kho hiện tại" prefWidth="130" style="-fx-alignment: CENTER; -fx-font-weight: bold; -fx-text-fill: #cf222e;"/>
                        <TableColumn fx:id="colLowMin"      text="Ngưỡng tối thiểu" prefWidth="130" style="-fx-alignment: CENTER;"/>
                    </columns>
                </TableView>
            </VBox>
        </Tab>
    </TabPane>

</VBox>
