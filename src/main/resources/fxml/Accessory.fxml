<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.petshop.controller.AccessoryController"
      stylesheets="@../css/styles.css"
      spacing="0"
      style="-fx-background-color: #f8f9fa;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="16" right="24" bottom="16" left="24"/>
        </padding>
        <Label text="🎒 Quản lý Phụ kiện &amp; Thức ăn"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAdd"
                text="+ Thêm phụ kiện"
                styleClass="btn-primary"
                onAction="#onAdd"/>
    </HBox>

    <!-- FILTER BAR -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="12" right="24" bottom="12" left="24"/>
        </padding>

        <TextField fx:id="txtSearch"
                   promptText="Tìm theo tên..."
                   prefWidth="220"
                   style="-fx-pref-height: 36px;"/>

        <ComboBox fx:id="cmbCategory"
                  promptText="Danh mục"
                  prefWidth="140"
                  style="-fx-pref-height: 36px;"/>

        <CheckBox fx:id="chkLowStock"
                  text="Chỉ hàng sắp hết"
                  onAction="#loadData"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button fx:id="btnRefresh"
                text="🔄 Làm mới"
                onAction="#onRefresh"
                style="-fx-pref-height: 36px;"/>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="tableAccessories"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colName"     text="Tên sản phẩm" prefWidth="240"/>
            <TableColumn fx:id="colCategory" text="Danh mục"      prefWidth="130" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colUnit"     text="ĐVT"           prefWidth="70"  style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colImport"   text="Giá nhập"      prefWidth="120" style="-fx-alignment: CENTER_RIGHT;"/>
            <TableColumn fx:id="colSell"     text="Giá bán"       prefWidth="120" style="-fx-alignment: CENTER_RIGHT;"/>
            <TableColumn fx:id="colQty"      text="Tồn kho"       prefWidth="90"  style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colMinQty"   text="Tối thiểu"     prefWidth="80"  style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colStatus"   text="Trạng thái"    prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colAction"   text="Hành động"     prefWidth="160" style="-fx-alignment: CENTER;" sortable="false"/>
        </columns>
    </TableView>

    <!-- STATUS BAR -->
    <HBox alignment="CENTER_LEFT" spacing="8"
          style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0;">
        <padding>
            <Insets top="8" right="24" bottom="8" left="24"/>
        </padding>
        <Label fx:id="lblStatus" text="Tổng: 0 sản phẩm" style="-fx-font-size: 13px; -fx-text-fill: #6c757d;"/>
    </HBox>

</VBox>
