<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.petshop.controller.ImportOrderController"
      stylesheets="@../css/styles.css"
      spacing="0"
      style="-fx-background-color: #f8f9fa;">

    <!-- HEADER -->
    <HBox alignment="CENTER_LEFT" spacing="12"
          style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="16" right="24" bottom="16" left="24"/>
        </padding>
        <Label text="📦 Quản lý Nhập hàng từ Nhà cung cấp"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #212529;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAdd"
                text="+ Tạo phiếu nhập mới"
                styleClass="btn-primary"
                onAction="#onNewImportOrder"/>
    </HBox>

    <!-- FILTER BAR -->
    <HBox alignment="CENTER_LEFT" spacing="10"
          style="-fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 1 0;">
        <padding>
            <Insets top="12" right="24" bottom="12" left="24"/>
        </padding>

        <Label text="Từ ngày:"/>
        <DatePicker fx:id="dpFrom" prefWidth="130" style="-fx-pref-height: 36px;"/>

        <Label text="Đến ngày:"/>
        <DatePicker fx:id="dpTo" prefWidth="130" style="-fx-pref-height: 36px;"/>

        <TextField fx:id="txtSearch"
                   promptText="Tìm theo mã phiếu, NCC..."
                   prefWidth="250"
                   style="-fx-pref-height: 36px;"/>

        <Button text="🔍 Lọc"
                styleClass="btn-outline"
                onAction="#loadData"
                style="-fx-pref-height: 36px;"/>

        <Region HBox.hgrow="ALWAYS"/>

        <Button text="🔄 Làm mới"
                styleClass="btn-outline"
                onAction="#onRefresh"
                style="-fx-pref-height: 36px;"/>
    </HBox>

    <!-- TABLE -->
    <TableView fx:id="tableOrders"
               VBox.vgrow="ALWAYS"
               style="-fx-background-color: white;">
        <columns>
            <TableColumn fx:id="colCode"     text="Mã phiếu"     prefWidth="140" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colDate"     text="Ngày nhập"     prefWidth="120" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colSupplier" text="Nhà cung cấp"  prefWidth="220"/>
            <TableColumn fx:id="colTotal"    text="Tổng tiền"     prefWidth="140" style="-fx-alignment: CENTER_RIGHT; -fx-font-weight: bold;"/>
            <TableColumn fx:id="colStaff"    text="Người tạo"     prefWidth="130"/>
            <TableColumn fx:id="colNote"     text="Ghi chú"       prefWidth="200"/>
            <TableColumn fx:id="colStatus"   text="Trạng thái"  prefWidth="100" style="-fx-alignment: CENTER;"/>
            <TableColumn fx:id="colAction"   text="Chi tiết"      prefWidth="150" style="-fx-alignment: CENTER;" sortable="false"/>
        </columns>
    </TableView>

    <!-- STATUS BAR -->
    <HBox alignment="CENTER_LEFT" spacing="16"
          style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6; -fx-border-width: 1 0 0 0;">
        <padding>
            <Insets top="8" right="24" bottom="8" left="24"/>
        </padding>
        <Label fx:id="lblStatus" text="Tổng: 0 phiếu nhập" style="-fx-font-size: 13px; -fx-text-fill: #6c757d;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTotalCost" text="Tổng tiền nhập: 0 đ" style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #cf222e;"/>
    </HBox>

</VBox>
